#!/usr/bin/env bash

# commit-msg hook that blocks commits that do not follow the project's conventional commits format

commit_msg_type_regex='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
commit_msg_scope_regex='[a-zA-Z0-9._/-]{1,20}'
commit_msg_description_regex='.{1,100}'

commit_msg_regex="^(${commit_msg_type_regex})(\(${commit_msg_scope_regex}\))?!?: (${commit_msg_description_regex})$"

merge_msg_regex="^Merge .+$"
revert_msg_regex='^Revert ".+"$'

commit_msg_file="${1:?missing commit message file}"
commit_msg_header="$(head -n 1 "$commit_msg_file")"

if [[ "$commit_msg_header" =~ $commit_msg_regex ]] ||
   [[ "$commit_msg_header" =~ $merge_msg_regex ]] ||
   [[ "$commit_msg_header" =~ $revert_msg_regex ]]; then
  exit 0
fi

echo "ERROR: Invalid commit message format" >&2
echo "$commit_msg_header" >&2
echo >&2
echo "Expected format:" >&2
echo "  type: description" >&2
echo "  type(scope): description" >&2
echo "  type!: description" >&2
echo "  type(scope)!: description" >&2
echo >&2
echo "Allowed types:" >&2
echo "  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2

exit 1
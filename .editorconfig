root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{lock,toml}]
indent_size = 4

[*.{ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.rs]
indent_size = 4

[*.{png,jpg,jpeg,gif,ico,svg,webp,pdf,exe,dll,dat,pdb}]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
trim_trailing_whitespace = unset

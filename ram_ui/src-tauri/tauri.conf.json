{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RM",
  "version": "1.16.0",
  "identifier": "com.paryxgames.roblox-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RM",
        "width": 1200,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}

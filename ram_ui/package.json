{
  "name": "roblox-manager-ui",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:debug": "node scripts/tauri.mjs build --debug --no-bundle",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "lint": "eslint . && stylelint \"frontend/**/*.css\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "tauri": "node scripts/tauri.mjs",
    "version:sync": "node scripts/tauri.mjs version:sync",
    "version:set": "node scripts/tauri.mjs version:set",
    "version:check": "node scripts/tauri.mjs version:check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.11.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
